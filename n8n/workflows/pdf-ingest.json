      "id": "34305a4f-4053-4600-b2c2-08531169bd12",
      "name": "Extract from File"
    },
    {
      "parameters": {
        "jsCode": "// Nodo 3: Normalizador de PDF al contrato de ingesta del backend\n// Referencia: docs/02-contratos.md §5\n\n// Traer el texto extraído por el nodo Extract from File\nconst rawText = $input.first().json.text || '';\n\n// Metadata que podría venir del panel de carga (por ahora vacía, después la sumamos)\nconst meta = {};\n\n// Limpieza básica del texto: normalizar saltos, espacios, líneas en blanco\nconst cleanedText = rawText\n  .replace(/\\r\\n/g, '\\n')\n  .replace(/[ \\t]+/g, ' ')\n  .replace(/\\n{3,}/g, '\\n\\n')\n  .trim();\n\n// Armar el documento con la forma exacta que espera el backend\nconst documento = {\n  code: meta.code || `IPF-PDF-${Date.now()}`,\n  title: meta.title || 'Documento cargado por el equipo editorial',\n  summary: cleanedText.slice(0, 500),\n  requirements: [],\n  office: null,\n  sourceUrl: meta.sourceUrl || 'N/A (carga manual del panel)',\n  capturedAt: new Date().toISOString().slice(0, 10),\n  validUntil: meta.validUntil || null,\n  isFictional: meta.isFictional === true,\n  fullText: cleanedText,\n};\n\n// Devolver en el formato que espera el próximo nodo\nreturn [\n  {\n    json: {\n      documents: [documento],\n    },\n  },\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "id": "13b21a1a-c689-4795-916b-03382ee67843",
      "name": "Code"
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "pdf-ingest",
        "options": {
          "rawBody": true
        }
      },
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "id": "0c0aa7cb-4b2f-46c3-87cd-0a1b3df9f00e",
      "name": "Webhook",
      "webhookId": "81427780-f060-4568-87ce-dd2ed8a9bdfa"
    },
    {
      "parameters": {
        "jsCode": "// Nodo 4: Serializar el body a string\n// El próximo nodo (Crypto) se encarga de firmarlo con HMAC-SHA256\n\nconst bodyObject = $input.first().json;\nconst bodyString = JSON.stringify(bodyObject);\n\nreturn [\n  {\n    json: {\n      body: bodyString,\n    },\n  },\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        340
      ],
      "id": "a4c5ce46-5da1-4b81-a064-fdb8ae6ad04e",
      "name": "Serialize Body"
    },
    {
      "parameters": {
        "action": "hmac",
        "type": "SHA256",
        "value": "={{ $json.body }}",
        "secret": "={{ $env.INGEST_HMAC_SECRET }}"
      },
      "type": "n8n-nodes-base.crypto",
      "typeVersion": 1,
      "position": [
        500,
        340
      ],
      "id": "bbf21861-03a6-4c5d-a90e-566ddced3173",
      "name": "Crypto"
    },
    {
      "parameters": {
        "jsCode": "// Nodo 6: Combinar body + firma con prefijo estándar\nconst input = $input.first().json;\n\nreturn [\n  {\n    json: {\n      body: input.body,\n      signature: `sha256=${input.data}`,\n    },\n  },\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
