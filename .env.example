# =============================================================================
# proyecto-promise — variables de entorno
# Copiar a .env (cp .env.example .env) y completar. .env NUNCA se commitea.
# Todo valor "CAMBIAR" debe reemplazarse: `make env-check` falla si queda alguno.
# Generar secretos con: openssl rand -hex 32
# =============================================================================

# --- General -----------------------------------------------------------------
NODE_ENV=development
APP_NAME=proyecto-promise
TZ=America/Argentina/Cordoba
# Perfiles de docker compose que levanta `make up` (separados por coma):
#   app   -> backend y frontend en contenedores (opcional: se pueden correr con npm en el host)
#   audio -> Speaches (transcripción local)       [P1]
#   pdf   -> n8n (ingesta de PDF)                  [P2]
COMPOSE_PROFILES=audio

# --- PostgreSQL + pgvector ---------------------------------------------------
POSTGRES_DB=promise
# Usuario administrador: solo migraciones y seed.
POSTGRES_USER=promise_admin
POSTGRES_PASSWORD=CAMBIAR
# Usuario de la aplicación: mínimo privilegio (SELECT/INSERT/UPDATE/DELETE), lo crea infra/postgres/init.
APP_DB_USER=promise_app
APP_DB_PASSWORD=CAMBIAR
# Host "db" dentro de docker; "localhost" si corrés el backend con npm en el host.
DATABASE_URL=postgresql://promise_app:CAMBIAR@localhost:5432/promise
MIGRATION_DATABASE_URL=postgresql://promise_admin:CAMBIAR@localhost:5432/promise

# --- Redis (memoria de conversación 24 h + rate limit) ----------------------
REDIS_PASSWORD=CAMBIAR
REDIS_URL=redis://:CAMBIAR@localhost:6379
SESSION_TTL_SECONDS=86400
SESSION_MAX_TURNS=3

# --- Backend (NestJS) ---------------------------------------------------------
BACKEND_PORT=3000
CORS_ORIGINS=http://localhost:5173
# Sal para seudonimizar teléfonos (hash). Si se pierde, las sesiones previas quedan huérfanas.
PHONE_HASH_SALT=CAMBIAR
RATE_LIMIT_WA_PER_PHONE_PER_MIN=6
RATE_LIMIT_WEB_PER_IP_PER_MIN=20
MAX_USER_MESSAGE_CHARS=1000

# --- LLM (el equipo ya cuenta con modelos; API compatible con OpenAI) ---------
LLM_BASE_URL=CAMBIAR
LLM_API_KEY=CAMBIAR
LLM_MODEL_ANSWER=CAMBIAR
LLM_MODEL_CLASSIFY=CAMBIAR
LLM_TIMEOUT_MS=20000
LLM_MAX_OUTPUT_TOKENS=800

# --- Embeddings ---------------------------------------------------------------
EMBEDDINGS_BASE_URL=CAMBIAR
EMBEDDINGS_API_KEY=CAMBIAR
EMBEDDINGS_MODEL=bge-m3
# Debe coincidir con la columna vector(N) de la migración. bge-m3 = 1024.
EMBEDDINGS_DIM=1024

# --- RAG ----------------------------------------------------------------------
RAG_TOP_K=4
RAG_MIN_SCORE=0.40

# --- Transcripción (Speaches, local) [P1] -----------------------------------
STT_BASE_URL=http://localhost:8000/v1
# PENDIENTE DE VALIDAR: modelo faster-whisper elegido tras la prueba cronometrada.
STT_MODEL=CAMBIAR
STT_MAX_AUDIO_SECONDS=120
STT_MAX_AUDIO_BYTES=5242880

# --- WhatsApp Cloud API -------------------------------------------------------
# PENDIENTE DE VALIDAR (Bloque 2): versión vigente de la Graph API.
WHATSAPP_API_VERSION=CAMBIAR
WHATSAPP_PHONE_NUMBER_ID=CAMBIAR
# Token de desarrollo: vence. Generarlo justo antes de empezar (21:00).
WHATSAPP_ACCESS_TOKEN=CAMBIAR
# App Secret: verifica la firma X-Hub-Signature-256 de cada webhook.
WHATSAPP_APP_SECRET=CAMBIAR
# Texto libre que se carga también en el panel de Meta al registrar el webhook.
WHATSAPP_VERIFY_TOKEN=CAMBIAR

# --- Túnel (solo desarrollo y webhook de Meta) --------------------------------
TUNNEL_TOOL=ngrok

# --- Panel de carga [P2] -----------------------------------------------------
PANEL_JWT_SECRET=CAMBIAR
PANEL_SESSION_MINUTES=60
PDF_MAX_BYTES=5242880

# --- n8n + ingesta [P2] ------------------------------------------------------
# PENDIENTE: fijar la versión exacta de la imagen que descargó Franco.
N8N_VERSION=CAMBIAR
N8N_ENCRYPTION_KEY=CAMBIAR
# Secreto HMAC compartido n8n <-> backend para /api/v1/internal/ingestion/batch.
INGEST_HMAC_SECRET=CAMBIAR
# Webhook de n8n que recibe el lote del scraper [P2.4, ver docs/03-scraper-y-rag.md].
N8N_SCRAPER_INGEST_WEBHOOK_URL=http://localhost:5678/webhook/scraper-ingest

# --- Scraper [P2] ------------------------------------------------------------
SCRAPER_USER_AGENT="proyecto-promise-scraper/0.1 (hackathon; uso educativo)"
SCRAPER_DELAY_MS=2000
SCRAPER_BASE_URL=https://ipfconecta.formosa.gob.ar
