# SERVIDOR
PORT=3005
# Orígenes permitidos para el chat web (separados por coma). Vacío = todos (solo desarrollo).
CORS_ORIGINS=http://localhost:5173

# OLLAMA
# Local:  OLLAMA_MODEL=llama3.2:3b
# Nube vía daemon local (requiere `ollama signin` + `ollama pull <modelo>-cloud`):
#         OLLAMA_MODEL=gpt-oss:20b-cloud
# Nube directa sin daemon: OLLAMA_URL=https://ollama.com, OLLAMA_MODEL=gpt-oss:20b y OLLAMA_API_KEY
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_API_KEY=
# Tamaño de contexto: la base de conocimiento va en el prompt, 8192 alcanza para arrancar.
OLLAMA_NUM_CTX=8192

# MEMORIA DE CONVERSACIÓN (en RAM)
HISTORY_MAX_TURNS=8
HISTORY_TTL_HOURS=24

# Sal para hashear teléfonos (nunca se guarda el número en claro). Inventá una cadena larga.
PHONE_HASH_SALT=

# WHATSAPP (opcional: si META_TOKEN está vacío, el webhook queda deshabilitado)
META_TOKEN=
META_PHONE_ID=
VERIFY_TOKEN=

# RAG (la ingesta la hace n8n: n8n/workflows/rag-ingest.json)
# Embeddings siempre con el Ollama local, aunque el chat use un modelo en la nube
EMBED_URL=http://localhost:11434
EMBED_MODEL=bge-m3
RAG_TOP_K=6
RAG_MIN_SCORE=0.35
RAG_STORE_PATH=data/vector-store.json
# Secreto compartido con n8n (header x-ingest-secret). Generalo con: openssl rand -hex 32
RAG_INGEST_SECRET=
